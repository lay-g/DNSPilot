IDENTITY_TEAM_IDENTIFIER = TEAMID1234
IDENTITY_BUNDLE_ID_PREFIX = org.example
#include? "Identity.local.xcconfig"

DEVELOPMENT_TEAM = $(IDENTITY_TEAM_IDENTIFIER)
MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated

EXPECTED_TEAM_IDENTIFIER = $(DEVELOPMENT_TEAM)
APP_GROUP_IDENTIFIER = group.$(DEVELOPMENT_TEAM).$(APP_BUNDLE_IDENTIFIER).ipc
MACH_SERVICE_BASE_NAME = $(APP_GROUP_IDENTIFIER).status
MACH_SERVICE_NAME = $(MACH_SERVICE_BASE_NAME).build$(CURRENT_PROJECT_VERSION)
MACH_SERVICE_LEGACY_NAME = $(MACH_SERVICE_BASE_NAME)
DNS_PROXY_PRODUCT_NAME = $(DNS_PROXY_BUNDLE_IDENTIFIER)
DNS_PROXY_LOGGING_MODE = default
DNS_PROXY_MANAGER_FAILURE_INJECTION_ALLOWED = NO
DNS_PROXY_GATE_A_PROBE_ALLOWED = NO
