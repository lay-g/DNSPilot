	<string>$(DNS_PROXY_MANAGER_FAILURE_INJECTION_ALLOWED)</string>
	<key>DNSPilotGateAProbeAllowed</key>
	<string>$(DNS_PROXY_GATE_A_PROBE_ALLOWED)</string>
	<key>DNSPilotExpectedTeamIdentifier</key>
	<string>$(EXPECTED_TEAM_IDENTIFIER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>DNSPilot uses your Wi-Fi network name to apply the automatic DNS rules you create.</string>
</dict>
</plist>
